# Database (Neon or self-hosted Postgres)
DATABASE_URL=postgresql://...

# Auth / consent signing secret (min 16 chars)
CONSENT_SECRET=your_consent_secret_here

# Site URL (Vercel deployment)
NEXT_PUBLIC_SITE_URL=https://matrioticstudios.com

# Contact form (Web3Forms is optional — the form records in the DB without it)
WEB3FORMS_ACCESS_KEY=your_web3forms_key_here

# ── Cloudflare R2 (optional) ─────────────────────────────────────────────
# When set, images are served from R2 with caching; otherwise /public assets.
# R2_ACCOUNT_ID=your_r2_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET=your_bucket_name
# R2_PUBLIC_URL=https://your.custom.domain

# ── Resend transactional email (optional) ────────────────────────────────
# Free tier: 100 emails/day, 3,000/month. Only essential mail is sent.
# RESEND_API_KEY=re_your_key
# RESEND_FROM_EMAIL=hello@matrioticstudios.com
# RESEND_FROM_NAME=Matriotic Studios