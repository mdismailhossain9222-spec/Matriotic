# ── Outreach System (Master Runner) ────────────────────────────────────
# Supabase Database
DATABASE_URL=postgresql://...
# Or for connection pooler:
# DATABASE_URL_POOLED=postgresql://...

# Outbound phone number for email signatures
OUTREACH_PHONE_NUMBER=+1234567890

# ── Google OAuth (for Gmail email sending) ──────────────────────────────
GMAIL_CLIENT_ID=your_client_id
GMAIL_CLIENT_SECRET=your_client_secret
GMAIL_REFRESH_TOKEN=your_refresh_token
GMAIL_SENDER_EMAIL=you@gmail.com

# ── Harvey - Email Verification (at least one) ──────────────────────────
REOON_API_KEY=your_reoon_key          # 600 free/mo — best free tier
ZEROBOUNCE_API_KEY=your_zerobounce_key # 100 free/mo — best for M365/Workspace catch-alls
HUNTER_API_KEY=your_hunter_key         # 50 free/mo + pattern lookup

# ── Discovery (optional) ───────────────────────────────────────────────
DATAFORSEO_LOGIN=your_login
DATAFORSEO_PASSWORD=your_password
DATAFORSEO_SANDBOX=any_value            # routes to free sandbox

# ── LinkedIn Prospecting (optional) ────────────────────────────────────
# LINKEDIN_EMAIL=your_linkedin_email
# LINKEDIN_PASSWORD=your_linkedin_password

# ── Contact form (Web3Forms is optional — the form records in the DB without it) ──
WEB3FORMS_ACCESS_KEY=your_web3forms_key_here

# ── Auth / consent signing secret (min 16 chars) ────────────────────────
CONSENT_SECRET=your_consent_secret_here

# Site URL (Vercel deployment)
NEXT_PUBLIC_SITE_URL=https://matrioticstudios.com

# ── Cloudflare R2 (optional) ─────────────────────────────────────────────
# When set, images are served from R2 with caching; otherwise /public assets.
# R2_ACCOUNT_ID=your_r2_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET=your_bucket_name
# R2_PUBLIC_URL=https://your.custom.domain

# ── Resend transactional email (optional) ────────────────────────────────
# Free tier: 100 emails/day, 3,000/month. Only essential mail is sent.
# RESEND_API_KEY=re_your_key
# RESEND_FROM_EMAIL=hello@matrioticstudios.com
# RESEND_FROM_NAME=Matriotic Studios